# SponTRIP — root environment variable index
#
# This file documents every variable NAME used anywhere in the monorepo.
# No real values live here — only placeholders. Real values go in
# gitignored .env files (root, apps/mobile/.env, apps/web/.env,
# supabase/.env) or, for CI, GitHub Actions repository secrets.
#
# NEVER commit a real value. NEVER put SUPABASE_SERVICE_ROLE_KEY (or any
# other secret) behind an EXPO_PUBLIC_ prefix — anything EXPO_PUBLIC_* is
# bundled into the client and is public. See ci/scripts/check-bundle-keys.ts.

# --- Supabase (client-safe, mobile app) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ENV=dev

# --- Supabase (server-side / CI / scripts only — NEVER in apps/mobile) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_PROJECT_REF=

# --- PostHog (client-safe project key, mobile app) ---
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- PostHog (server-side — fixture seeding + Insights query API) ---
POSTHOG_CAPTURE_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# --- Sentry ---
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Resend (transactional email) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# --- Cloudflare R2 (object storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_GENERAL=general
R2_BUCKET_RECEIPTS=receipts
R2_BUCKET_VERIFICATION=verification
# Environment-prefixed paths within the buckets above, e.g. dev/general/...
R2_ENV_PREFIX=dev

# --- Cloudflare Pages (web deploy) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT_NAME=

# --- Expo / EAS ---
EXPO_TOKEN=

# --- Edge Functions: shared secret for cron-invoked / manual-harness functions ---
CRON_SHARED_SECRET=

# --- Edge Functions: Expo Push harness (send-test-push) ---
EXPO_ACCESS_TOKEN=
# Must be the literal string "true" to enable send-test-push at all (404s
# otherwise) — set in dev/stage secrets, leave UNSET in production so this
# debug endpoint 404s there even if deployed. See send-test-push/index.ts.
ALLOW_TEST_PUSH=
