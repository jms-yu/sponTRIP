# apps/web local dev environment (gitignored as apps/web/.env).
# Astro exposes only PUBLIC_* prefixed variables to client-side code —
# same principle as apps/mobile's EXPO_PUBLIC_* convention. Never put a
# secret behind a PUBLIC_ prefix.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SPONTRIP_SITE_URL=http://localhost:4321
