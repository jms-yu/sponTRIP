# apps/mobile local dev environment (gitignored as apps/mobile/.env).
# Only EXPO_PUBLIC_* variables are readable by the client bundle — see
# ci/scripts/check-bundle-keys.ts (SEC-3), which fails CI on any
# EXPO_PUBLIC_* var containing SERVICE or SECRET, or any reference to
# SUPABASE_SERVICE_ROLE_KEY anywhere in this app. Never put a secret key
# behind an EXPO_PUBLIC_ prefix.

EXPO_PUBLIC_ENV=dev
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
