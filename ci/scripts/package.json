{
  "name": "@sponTRIP/ci-scripts",
  "private": true,
  "version": "0.0.0",
  "description": "SponTRIP CI mechanical-check scripts — each script is a process exit-code contract (0 = pass). Run via tsx.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:merge": "vitest run --config vitest.merge.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@supabase/supabase-js": "^2.117.2",
    "glob": "^13.0.6",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
